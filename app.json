{
  "expo": {
    "name": "TheStillness",
    "slug": "TheStillness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "updates": {
      "enabled": false
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thestillness.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Разрешите доступ для сохранения отчётов",
        "NSPhotoLibraryAddUsageDescription": "Разрешите сохранение отчётов в библиотеку"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.thestillness.app",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#004a7c",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Разрешите доступ для сохранения отчётов",
          "savePhotosPermission": "Разрешите сохранение отчётов на устройство",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}